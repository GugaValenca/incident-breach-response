# Copy this file to .env for local overrides, or set these as real
# environment variables on your host's dashboard (Vercel: Project ->
# Settings -> Environment Variables). Never commit an actual .env file —
# it's already in .gitignore.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-freshly-generated-secret-key

# Keep True for local development. Defaults to False on Vercel; set it to
# False for any other real deployment. With DEBUG off, the app refuses to
# start unless DJANGO_SECRET_KEY above is set.
DJANGO_DEBUG=True

# Comma-separated list of hosts allowed to serve the app. Required
# (non-empty) once DJANGO_DEBUG=False, in addition to whatever
# *.vercel.app hostname Vercel already trusts automatically at runtime.
# Example: DJANGO_ALLOWED_HOSTS=incident-breach-response.example.com
DJANGO_ALLOWED_HOSTS=

# Postgres connection string. Leave unset locally to keep using SQLite.
# Vercel's Postgres integration (Storage tab -> Create Database) injects
# POSTGRES_URL into the project automatically once connected — you
# shouldn't need to set this one by hand there. DATABASE_URL is read
# first if both are present, for compatibility with other hosts.
DATABASE_URL=
